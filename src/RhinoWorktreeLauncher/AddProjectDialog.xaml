<Window x:Class="RhinoWorktreeLauncher.AddProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add project"
        Width="590"
        Height="710"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBodyBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#16181B" />
        <SolidColorBrush x:Key="PanelBrush" Color="#1A1C20" />
        <SolidColorBrush x:Key="ControlBrush" Color="#1B1D21" />
        <SolidColorBrush x:Key="ControlHoverBrush" Color="#22252A" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#2A2E34" />
        <SolidColorBrush x:Key="DividerBrush" Color="#25292E" />
        <SolidColorBrush x:Key="TextStrongBrush" Color="#F0F2F5" />
        <SolidColorBrush x:Key="TextBodyBrush" Color="#E6E8EB" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9298A1" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#707780" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#F0F2F5" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#16181B" />
        <SolidColorBrush x:Key="AccentBrush" Color="#7FAE7A" />

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.76" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Border x:Name="Track"
                                    Background="{DynamicResource PanelBorderBrush}"
                                    CornerRadius="11" />
                            <Ellipse x:Name="Thumb"
                                     Width="16"
                                     Height="16"
                                     Margin="3"
                                     HorizontalAlignment="Left"
                                     Fill="{DynamicResource TextSecondaryBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Fill" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="28,24,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="EyebrowText" Text="ADD PROJECT"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontFamily="{StaticResource MonoFont}"
                       FontSize="10"
                       FontWeight="Medium" />
            <TextBlock x:Name="HeadingText" Margin="0,7,0,0"
                       Text="Grant RWL access"
                       Foreground="{DynamicResource TextStrongBrush}"
                       FontSize="22"
                       FontWeight="Medium" />
            <TextBlock x:Name="ProjectPathText"
                       Margin="0,7,0,0"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontFamily="{StaticResource MonoFont}"
                       FontSize="11" />
        </StackPanel>

        <Border Grid.Row="2"
                Padding="18,16"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="26" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Column="0" Width="2" Margin="5,8,0,-10" Background="{DynamicResource DividerBrush}" />
                <Border Grid.Column="0" Width="10" Height="10" VerticalAlignment="Top" Margin="1,5,0,0"
                        Background="{DynamicResource AccentBrush}" CornerRadius="2" />
                <StackPanel Grid.Column="1">
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="Project files" Foreground="{DynamicResource TextStrongBrush}" FontWeight="Medium" />
                        <Border Margin="9,0,0,0" Padding="6,2" Background="{DynamicResource ControlBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="4">
                            <TextBlock Text="REQUIRED" Foreground="{DynamicResource TextMutedBrush}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="8.5" />
                        </Border>
                    </DockPanel>
                    <TextBlock Margin="0,4,16,0"
                               Text="Read this Git project and build the selected solution in its worktrees."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11.5" />
                </StackPanel>

                <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,12,0,12"
                        Height="1" Background="{DynamicResource DividerBrush}" />

                <Border Grid.Row="2" Grid.Column="0" Width="10" Height="10" VerticalAlignment="Top" Margin="1,5,0,0"
                        Background="{DynamicResource TextMutedBrush}" CornerRadius="5" />
                <StackPanel Grid.Row="2" Grid.Column="1">
                    <TextBlock Text="Remote status" Foreground="{DynamicResource TextStrongBrush}" FontWeight="Medium" />
                    <TextBlock Margin="0,4,16,0"
                               Text="Read remote branches and pull requests into RWL storage. You can turn this off later."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11.5" />
                </StackPanel>
                <CheckBox x:Name="RemoteReadToggle"
                          Grid.Row="2"
                          Grid.Column="2"
                          Margin="12,1,0,0"
                          VerticalAlignment="Top"
                          IsChecked="True"
                          Style="{StaticResource Switch}" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="4">
            <TextBlock Text="CANONICAL BUILD"
                       Margin="2,0,0,9"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontFamily="{StaticResource MonoFont}"
                       FontSize="10" />
            <TextBlock Text="Rhino plug-in project" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" />
            <ComboBox x:Name="PluginProjectComboBox"
                      Margin="0,7,0,16"
                      ItemTemplate="{StaticResource PluginProjectDropdownValue}"
                      SelectionChanged="PluginProject_SelectionChanged"
                      Tag="Select a plug-in project"
                      Style="{StaticResource BuildCombo}" />
            <TextBlock Text="Solution" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" />
            <ComboBox x:Name="SolutionComboBox"
                      Margin="0,7,0,16"
                      ItemTemplate="{StaticResource SolutionDropdownValue}"
                      IsEnabled="False"
                      SelectionChanged="Solution_SelectionChanged"
                      Tag="Select a plug-in project first"
                      Style="{StaticResource BuildCombo}" />
            <TextBlock Text="Configuration" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" />
            <ComboBox x:Name="BuildConfigurationComboBox"
                      Margin="0,7,0,0"
                      ItemTemplate="{StaticResource BuildConfigurationDropdownValue}"
                      IsEnabled="False"
                      Tag="Select a solution first"
                      Style="{StaticResource BuildCombo}" />
            <TextBlock x:Name="ValidationText" Margin="0,7,0,0" Foreground="#C07D76" FontSize="11" Visibility="Collapsed" />
        </StackPanel>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Build outputs are written by the selected solution."
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="10.5" />
            </StackPanel>
            <Button Grid.Column="1" Width="86" Content="Cancel" Style="{StaticResource QuietButton}" Click="Cancel_Click" />
            <Button x:Name="ConfirmButton" Grid.Column="3" Width="154" Content="Grant access and add" Style="{StaticResource ActionButton}" Click="Add_Click" />
        </Grid>
    </Grid>
</Window>
