<Window x:Class="RhinoWorktreeLauncher.AddProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add project"
        Width="590"
        Height="710"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBodyBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <!-- The palette, the shadows and the shared dialog controls come from
         Themes/DialogStyles.xaml, so only the styles this window alone draws are stated
         here. The two buttons keep their own metrics because the footer sizes them to a
         fixed width that the Project Settings buttons, being larger, would overflow. -->
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.76" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Border x:Name="Track"
                                    Background="{DynamicResource PanelBorderBrush}"
                                    CornerRadius="11" />
                            <Ellipse x:Name="Thumb"
                                     Width="16"
                                     Height="16"
                                     Margin="3"
                                     HorizontalAlignment="Left"
                                     Fill="{DynamicResource TextSecondaryBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Fill" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="28,24,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="EyebrowText" Text="ADD PROJECT"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontFamily="{StaticResource MonoFont}"
                       FontSize="10"
                       FontWeight="Medium" />
            <TextBlock x:Name="HeadingText" Margin="0,7,0,0"
                       Text="Grant RWL access"
                       Foreground="{DynamicResource TextStrongBrush}"
                       FontSize="22"
                       FontWeight="Medium" />
            <Grid Margin="0,7,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="ProjectPathRail"
                        Grid.Column="0"
                        Width="1"
                        Height="12"
                        Margin="0,0,9,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource DividerBrush}" />
                <TextBlock x:Name="ProjectPathText"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="11" />
            </Grid>
        </StackPanel>

        <Border Grid.Row="2"
                Padding="18,16"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
            <!-- Both access items share one grid, so the marker gutter, the text column and
                 the toggle column are stated once and cannot drift apart between the two.
                 Each item owns a title row and a description row: a marker centres on its
                 own title row, which is what keeps it in place when the REQUIRED badge makes
                 one title taller than the other. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="RequiredMarker" Grid.Row="0" Grid.Column="0" Width="10" Height="10"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource AccentBrush}" CornerRadius="2" />
                <DockPanel x:Name="RequiredTitle" Grid.Row="0" Grid.Column="1" LastChildFill="False">
                    <TextBlock VerticalAlignment="Center" Text="Project files"
                               Foreground="{DynamicResource TextStrongBrush}" FontWeight="Medium" />
                    <Border VerticalAlignment="Center" Margin="9,0,0,0" Padding="6,2"
                            Background="{DynamicResource ControlBrush}"
                            BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="4">
                        <TextBlock Text="REQUIRED" Foreground="{DynamicResource TextMutedBrush}"
                                   FontFamily="{StaticResource MonoFont}" FontSize="8.5" />
                    </Border>
                </DockPanel>

                <!-- The rail annotates the required item's description, so it takes its
                     extent from that row rather than from a hand-set length. -->
                <Border x:Name="RequiredRail" Grid.Row="1" Grid.Column="0" Width="2" Margin="0,3,0,0"
                        HorizontalAlignment="Center" VerticalAlignment="Stretch"
                        Background="{DynamicResource DividerBrush}" />
                <TextBlock x:Name="RequiredDescription"
                           Grid.Row="1"
                           Grid.Column="1"
                           Margin="0,4,0,0"
                           Text="Read this Git project and build the selected solution in its worktrees."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="11.5" />

                <Border x:Name="AccessDivider" Grid.Row="2" Grid.ColumnSpan="3" Margin="0,13"
                        Height="1" Background="{DynamicResource DividerBrush}" />

                <Border x:Name="OptionalMarker" Grid.Row="3" Grid.Column="0" Width="10" Height="10"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource TextMutedBrush}" CornerRadius="5" />
                <TextBlock x:Name="OptionalTitle" Grid.Row="3" Grid.Column="1"
                           VerticalAlignment="Center" Text="Remote status"
                           Foreground="{DynamicResource TextStrongBrush}" FontWeight="Medium" />
                <CheckBox x:Name="RemoteReadToggle"
                          Grid.Row="3"
                          Grid.Column="2"
                          Margin="12,0,0,0"
                          VerticalAlignment="Center"
                          IsChecked="True"
                          Style="{StaticResource Switch}" />
                <TextBlock x:Name="OptionalDescription"
                           Grid.Row="4"
                           Grid.Column="1"
                           Margin="0,4,0,0"
                           Text="Read remote branches and pull requests into RWL storage. You can turn this off later."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="11.5" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="4">
            <TextBlock x:Name="BuildSectionCaption"
                       Text="CANONICAL BUILD"
                       Margin="0,0,0,9"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontFamily="{StaticResource MonoFont}"
                       FontSize="10" />
            <TextBlock x:Name="PluginProjectCaption" Text="Rhino plug-in project" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" />
            <ComboBox x:Name="PluginProjectComboBox"
                      Margin="0,7,0,16"
                      ItemTemplate="{StaticResource PluginProjectDropdownValue}"
                      SelectionChanged="PluginProject_SelectionChanged"
                      Tag="Select a plug-in project"
                      Style="{StaticResource BuildCombo}" />
            <TextBlock Text="Solution" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" />
            <ComboBox x:Name="SolutionComboBox"
                      Margin="0,7,0,16"
                      ItemTemplate="{StaticResource SolutionDropdownValue}"
                      IsEnabled="False"
                      SelectionChanged="Solution_SelectionChanged"
                      Tag="Select a plug-in project first"
                      Style="{StaticResource BuildCombo}" />
            <TextBlock Text="Configuration" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" />
            <ComboBox x:Name="BuildConfigurationComboBox"
                      Margin="0,7,0,0"
                      ItemTemplate="{StaticResource BuildConfigurationDropdownValue}"
                      IsEnabled="False"
                      Tag="Select a solution first"
                      Style="{StaticResource BuildCombo}" />
            <TextBlock x:Name="ValidationText"
                       Margin="0,7,0,0"
                       Foreground="{DynamicResource ValidationBrush}"
                       FontSize="11"
                       Visibility="Collapsed" />
        </StackPanel>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Build outputs are written by the selected solution."
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="10.5" />
            </StackPanel>
            <Button Grid.Column="1" Width="86" Content="Cancel" Style="{StaticResource QuietButton}" Click="Cancel_Click" />
            <Button x:Name="ConfirmButton" Grid.Column="3" Width="154" Content="Grant access and add" Style="{StaticResource ActionButton}" Click="Add_Click" />
        </Grid>
    </Grid>
</Window>
