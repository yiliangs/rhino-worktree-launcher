<Window x:Class="RhinoWorktreeLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rhino Worktree Launcher"
        Width="480"
        Height="650"
        MinWidth="430"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#111315"
        Foreground="#ECECEA"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#111315" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#181B1E" />
        <SolidColorBrush x:Key="SelectedBrush" Color="#22262A" />
        <SolidColorBrush x:Key="LineBrush" Color="#2A2E32" />
        <SolidColorBrush x:Key="TextBrush" Color="#ECECEA" />
        <SolidColorBrush x:Key="MutedBrush" Color="#92989E" />
        <SolidColorBrush x:Key="DimBrush" Color="#656C72" />
        <SolidColorBrush x:Key="AccentBrush" Color="#88B9E8" />

        <Style x:Key="UtilityButton" TargetType="Button">
            <Setter Property="Foreground" Value="#AEB4B9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#202428" />
                                <Setter Property="Foreground" Value="#F2F2EF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#292E33" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#202428" />
            <Setter Property="BorderBrush" Value="#34393E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#292E33" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#32383E" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Foreground" Value="#121416" />
            <Setter Property="Background" Value="#ECECEA" />
            <Setter Property="BorderBrush" Value="#ECECEA" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#D8D8D4" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="8" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Margin="2,1"
                                                        Background="#4A5055"
                                                        CornerRadius="2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProjectTabItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Tab"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="#1D2124" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="#262A2E" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row"
                                Padding="14,11"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="0,0,0,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#1B1F22" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource SelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="82" />
            <RowDefinition Height="46" />
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="42" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="22,18,22,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Width="40"
                    Height="40"
                    Background="#C4C4C4"
                    CornerRadius="7">
                <Image Source="Assets/rhino-launcher.png"
                       Width="40"
                       Height="40"
                       Stretch="Uniform" />
            </Border>

            <StackPanel Grid.Column="1" Margin="12,1,12,0">
                <TextBlock Text="Rhino Launcher"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="16"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="RepositoryPathText"
                           Margin="0,5,0,0"
                           Foreground="{StaticResource MutedBrush}"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="9.5"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Button Grid.Column="2"
                    Style="{StaticResource UtilityButton}"
                    Content="Refresh"
                    VerticalAlignment="Top"
                    Click="Refresh_Click" />
        </Grid>

        <Grid Grid.Row="1" Margin="22,0,22,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="ProjectList"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemContainerStyle="{StaticResource ProjectTabItem}"
                     SelectionChanged="ProjectList_SelectionChanged">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" FontSize="10.5" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button Grid.Column="1"
                    Style="{StaticResource UtilityButton}"
                    Content="Add project"
                    Click="AddProject_Click" />
        </Grid>

        <Grid Grid.Row="2" Margin="22,0,22,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="WORKTREES"
                       Foreground="{StaticResource DimBrush}"
                       FontSize="9"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="Double-click to launch"
                       Foreground="#5F666C"
                       FontSize="9"
                       VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="3"
                Margin="22,0,22,0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="7">
            <ListBox x:Name="WorktreeList"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="WorktreeList_SelectionChanged"
                     MouseDoubleClick="WorktreeList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ToolTip="{Binding Path}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Ellipse x:Name="Indicator"
                                     Width="6"
                                     Height="6"
                                     Margin="0,0,12,0"
                                     Fill="#666D73"
                                     VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding DisplayName}"
                                           Foreground="{StaticResource TextBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding BranchName}"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontFamily="Cascadia Mono, Consolas"
                                           FontSize="9.5"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding KindLabel}"
                                           HorizontalAlignment="Right"
                                           Foreground="#A7ADB2"
                                           FontSize="9.5" />
                                <TextBlock Text="{Binding AvailabilityLabel}"
                                           Margin="0,4,0,0"
                                           HorizontalAlignment="Right"
                                           Foreground="{StaticResource DimBrush}"
                                           FontSize="8.5" />
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                <Setter TargetName="Indicator" Property="Fill" Value="{StaticResource AccentBrush}" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsPrimary}" Value="False" />
                                    <Condition Binding="{Binding CanLaunch}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Indicator" Property="Fill" Value="#A8C67B" />
                            </MultiDataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="4" Margin="22,0,22,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Ellipse x:Name="StatusDot"
                     Width="6"
                     Height="6"
                     Fill="#737A80"
                     VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText"
                       Grid.Column="1"
                       Margin="8,0,0,0"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="10"
                       VerticalAlignment="Center"
                       Text="Scanning worktrees..."
                       TextTrimming="CharacterEllipsis" />
        </Grid>

        <Border Grid.Row="5"
                Padding="22,10,22,12"
                Background="#0D0F11"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="OpenFolderButton"
                        Style="{StaticResource SecondaryButton}"
                        Content="Open folder"
                        IsEnabled="False"
                        Click="OpenFolder_Click" />
                <Button x:Name="LaunchButton"
                        Grid.Column="2"
                        Style="{StaticResource PrimaryButton}"
                        Content="Select a worktree"
                        IsEnabled="False"
                        Click="Launch_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
