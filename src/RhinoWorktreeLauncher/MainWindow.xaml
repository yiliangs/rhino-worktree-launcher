<Window x:Class="RhinoWorktreeLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Rhino Worktree Launcher"
        Width="720"
        Height="1000"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#16181B"
        Foreground="#E6E8EB"
        FontFamily="{StaticResource UiFont}"
        Loaded="Window_Loaded"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <FontFamily x:Key="UiFont">/RhinoWorktreeLauncher;component/Assets/Fonts/#IBM Plex Sans</FontFamily>
        <FontFamily x:Key="MonoFont">/RhinoWorktreeLauncher;component/Assets/Fonts/#Geist Mono</FontFamily>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <SolidColorBrush x:Key="WindowBrush" Color="#16181B" />
        <SolidColorBrush x:Key="PanelBrush" Color="#1A1C20" />
        <SolidColorBrush x:Key="FooterBrush" Color="#121417" />
        <SolidColorBrush x:Key="ControlBrush" Color="#1B1D21" />
        <SolidColorBrush x:Key="ControlHoverBrush" Color="#22252A" />
        <SolidColorBrush x:Key="DividerBrush" Color="#232629" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#26292E" />
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#2E3238" />
        <SolidColorBrush x:Key="ControlHoverBorderBrush" Color="#464C54" />
        <SolidColorBrush x:Key="TitleBrush" Color="#F0F2F5" />
        <SolidColorBrush x:Key="BodyBrush" Color="#CDD2D9" />
        <SolidColorBrush x:Key="SecondaryBrush" Color="#878D95" />
        <SolidColorBrush x:Key="TertiaryBrush" Color="#6C727A" />
        <SolidColorBrush x:Key="DimBrush" Color="#5D646C" />

        <DrawingBrush x:Key="SelectionTexture"
                      TileMode="Tile"
                      Viewport="0,0,8,8"
                      ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#0F9AA8BB" Thickness="1" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <LineGeometry StartPoint="0,8" EndPoint="8,0" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Foreground" Value="#878D95" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,8" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#B4C0CF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#BEC4CC" />
            <Setter Property="Background" Value="{StaticResource ControlBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="20,12" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4"
                                                  Direction="270"
                                                  ShadowDepth="1"
                                                  Opacity="0.3"
                                                  Color="#000000" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ControlHoverBorderBrush}" />
                                <Setter Property="Foreground" Value="#ECEFF2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#292D32" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RefreshButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Foreground" Value="#B2B8C0" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="3"
                                                  Direction="270"
                                                  ShadowDepth="1"
                                                  Opacity="0.3"
                                                  Color="#000000" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ControlHoverBorderBrush}" />
                                <Setter Property="Foreground" Value="#ECEFF2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#292D32" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#16181B" />
            <Setter Property="Background" Value="#F0F2F5" />
            <Setter Property="BorderBrush" Value="#F0F2F5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="26,12" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18"
                                                  Direction="270"
                                                  ShadowDepth="3"
                                                  Opacity="0.24"
                                                  Color="#C8D2E1" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FFFFFF" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#E3E6EA" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProjectTagItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#D3D8DE" />
            <Setter Property="Background" Value="#0D9AA8BB" />
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Tag"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Tag" Property="BorderBrush" Value="#333941" />
                                <Setter TargetName="Tag" Property="Background" Value="#12171D" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tag" Property="BorderBrush" Value="#3B4148" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WorktreeRowItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="13,11" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Background="Transparent">
                            <Border x:Name="RowBackground"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="9" />
                            <Border x:Name="Texture"
                                    Background="{StaticResource SelectionTexture}"
                                    CornerRadius="9"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Offset="0" Color="#00000000" />
                                        <GradientStop Offset="0.42" Color="#00000000" />
                                        <GradientStop Offset="0.70" Color="#8C000000" />
                                        <GradientStop Offset="1" Color="#FF000000" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBackground" Property="Background" Value="#1F2226" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBackground" Property="Background" Value="#212429" />
                                <Setter TargetName="Texture" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Opacity="0"
                                                  Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Margin="1"
                                                        Background="#343840"
                                                        CornerRadius="3" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Opacity="0"
                                                  Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="26,0,26,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,26,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="50"
                        Height="50"
                        Background="#F4F6F8"
                        CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16"
                                          Direction="270"
                                          ShadowDepth="4"
                                          Opacity="0.28"
                                          Color="#000000" />
                    </Border.Effect>
                    <Image Width="50"
                           Height="50"
                           Source="Assets/rhino-launcher.png"
                           Stretch="Uniform" />
                </Border>

                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Text="Rhino Launcher"
                           Foreground="{StaticResource TitleBrush}"
                           FontFamily="{StaticResource UiFont}"
                           FontSize="23"
                           FontWeight="Medium" />

                <Button Grid.Column="3"
                        Style="{StaticResource RefreshButton}"
                        automation:AutomationProperties.Name="Refresh"
                        Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="13" Height="13" Margin="0,0,7,0">
                            <Path Width="16"
                                  Height="16"
                                  Data="M13.5,5.5 A6,6 0 1 0 14,10 M13.5,2 V5.5 H10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Fill="Transparent" />
                        </Viewbox>
                        <TextBlock VerticalAlignment="Center" Text="Refresh" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ListBox x:Name="ProjectList"
                         Grid.Column="0"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource ProjectTagItem}"
                         SelectionChanged="ProjectList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="RepositoryPathText"
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"
                           Foreground="{StaticResource TertiaryBrush}"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="10.5" />

                <Button Grid.Column="3"
                        Margin="10,0,0,0"
                        Style="{StaticResource TextButton}"
                        Content="＋ Add project"
                        Click="AddProject_Click" />
            </Grid>

            <Border Grid.Row="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                <Grid ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="20,16,20,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="9" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="WORKTREES"
                                   Foreground="{StaticResource SecondaryBrush}"
                                   FontFamily="{StaticResource UiFont}"
                                   FontSize="10.5"
                                   FontWeight="Medium" />
                        <TextBlock x:Name="WorktreeCountText"
                                   Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource DimBrush}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="11" />
                        <TextBlock x:Name="PanelHintText"
                                   Grid.Column="4"
                                   VerticalAlignment="Center"
                                   Text="Double-click to launch"
                                   Foreground="{StaticResource TertiaryBrush}"
                                   FontFamily="{StaticResource UiFont}"
                                   FontSize="11.5" />
                    </Grid>

                    <Border Grid.Row="0"
                            VerticalAlignment="Bottom"
                            Height="1"
                            Background="{StaticResource DividerBrush}" />

                    <Grid Grid.Row="1">
                        <ListBox x:Name="WorktreeList"
                                 Margin="8"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemContainerStyle="{StaticResource WorktreeRowItem}"
                                 SelectionChanged="WorktreeList_SelectionChanged"
                                 MouseDoubleClick="WorktreeList_MouseDoubleClick"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="7" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                                            <TextBlock x:Name="WorktreeName"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       Foreground="{StaticResource BodyBrush}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="14"
                                                       FontWeight="Normal" />
                                            <Border x:Name="DefaultBadge"
                                                    Margin="9,0,0,0"
                                                    Padding="6,3"
                                                    VerticalAlignment="Center"
                                                    Background="#1F2329"
                                                    BorderBrush="#333941"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Visibility="{Binding IsPrimary, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="DEFAULT"
                                                           Foreground="#A5AEBA"
                                                           FontFamily="{StaticResource UiFont}"
                                                           FontSize="9"
                                                           FontWeight="Medium" />
                                            </Border>
                                        </StackPanel>

                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Padding="7,3"
                                                    Background="#1E2125"
                                                    BorderBrush="#282C31"
                                                    BorderThickness="1"
                                                    CornerRadius="4">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="BehindText"
                                                               Text="{Binding BehindCount, StringFormat={}{0} behind}"
                                                               Foreground="#C07D76"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               FontSize="10.5" />
                                                    <Border Width="1"
                                                            Height="9"
                                                            Margin="7,0"
                                                            VerticalAlignment="Center"
                                                            Background="#2E3238" />
                                                    <TextBlock x:Name="AheadText"
                                                               Text="{Binding AheadCount, StringFormat={}{0} ahead}"
                                                               Foreground="#7FAE7A"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               FontSize="10.5" />
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Grid.Column="2"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding RelativeActivityLabel}"
                                                       Foreground="#6A7078"
                                                       FontFamily="{StaticResource UiFont}"
                                                       FontSize="11" />
                                        </Grid>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding AheadCount}" Value="0">
                                            <Setter TargetName="AheadText" Property="Foreground" Value="#484E56" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding BehindCount}" Value="0">
                                            <Setter TargetName="BehindText" Property="Foreground" Value="#484E56" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                            <Setter TargetName="WorktreeName" Property="Foreground" Value="#F2F4F7" />
                                            <Setter TargetName="WorktreeName" Property="FontWeight" Value="Medium" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="EmptyStateText"
                                   Margin="40"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="No worktrees found"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TertiaryBrush}"
                                   FontFamily="{StaticResource UiFont}"
                                   FontSize="12"
                                   Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Padding="26,14,26,18"
                Background="{StaticResource FooterBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="SELECTED"
                               Foreground="{StaticResource DimBrush}"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="10" />
                    <TextBlock x:Name="SelectedWorktreeText"
                               Margin="0,5,0,0"
                               Text="No worktree selected"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               Foreground="#C5CBD3"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="12.5"
                               FontWeight="Medium" />
                </StackPanel>

                <Button x:Name="OpenFolderButton"
                        Grid.Column="2"
                        Style="{StaticResource SecondaryButton}"
                        Content="Open folder"
                        Click="OpenFolder_Click" />

                <Button x:Name="LaunchButton"
                        Grid.Column="4"
                        Style="{StaticResource PrimaryButton}"
                        Content="Launch Rhino"
                        Click="Launch_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
