<Window x:Class="RhinoWorktreeLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RhinoWorktreeLauncher"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Rhino Worktree Launcher"
        Width="720"
        Height="1000"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBodyBrush}"
        FontFamily="{StaticResource UiFont}"
        Loaded="Window_Loaded"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextHintingMode="Fixed">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <SolidColorBrush x:Key="WindowBrush" Color="#16181B" />
        <SolidColorBrush x:Key="PanelBrush" Color="#1A1C20" />
        <SolidColorBrush x:Key="FooterBrush" Color="#121417" />
        <SolidColorBrush x:Key="ControlBrush" Color="#1B1D21" />
        <SolidColorBrush x:Key="ControlHoverBrush" Color="#22252A" />
        <SolidColorBrush x:Key="ProgressBrush" Color="#247FAE7A" />
        <SolidColorBrush x:Key="TagBrush" Color="#0D9AA8BB" />
        <SolidColorBrush x:Key="BadgeBrush" Color="#1F2329" />
        <SolidColorBrush x:Key="DiffBoxBrush" Color="#1E2125" />
        <SolidColorBrush x:Key="RowHoverBrush" Color="#1F2226" />
        <SolidColorBrush x:Key="RowActiveBrush" Color="#262B31" />
        <SolidColorBrush x:Key="TrackBrush" Color="#1C1F23" />
        <SolidColorBrush x:Key="TrackCenterBrush" Color="#3A4048" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#26292E" />
        <SolidColorBrush x:Key="DividerBrush" Color="#232629" />
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#2E3238" />
        <SolidColorBrush x:Key="ControlHoverBorderBrush" Color="#464C54" />
        <SolidColorBrush x:Key="TagBorderBrush" Color="#232629" />
        <SolidColorBrush x:Key="BadgeBorderBrush" Color="#333941" />
        <SolidColorBrush x:Key="DiffBoxBorderBrush" Color="#282C31" />
        <SolidColorBrush x:Key="TextStrongBrush" Color="#F0F2F5" />
        <SolidColorBrush x:Key="TextBodyBrush" Color="#E6E8EB" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#878D95" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#6C727A" />
        <SolidColorBrush x:Key="TextFaintBrush" Color="#5D646C" />
        <SolidColorBrush x:Key="TextBadgeBrush" Color="#A5AEBA" />
        <SolidColorBrush x:Key="ControlTextBrush" Color="#B2B8C0" />
        <SolidColorBrush x:Key="AheadTextBrush" Color="#7FAE7A" />
        <SolidColorBrush x:Key="BehindTextBrush" Color="#C07D76" />
        <SolidColorBrush x:Key="ZeroTextBrush" Color="#484E56" />
        <SolidColorBrush x:Key="AheadFillBrush" Color="#5F8A5C" />
        <SolidColorBrush x:Key="BehindFillBrush" Color="#9E5F59" />
        <SolidColorBrush x:Key="FreshTextBrush" Color="#8FAE8B" />
        <SolidColorBrush x:Key="FreshBackgroundBrush" Color="#127FAE7A" />
        <SolidColorBrush x:Key="FreshBorderBrush" Color="#2C3A2F" />
        <SolidColorBrush x:Key="StaleTextBrush" Color="#8A9099" />
        <SolidColorBrush x:Key="StaleBackgroundBrush" Color="#0D9AA8BB" />
        <SolidColorBrush x:Key="StaleBorderBrush" Color="#282C31" />
        <SolidColorBrush x:Key="PatternBrush" Color="#1AB2C0D3" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#F0F2F5" />
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#16181B" />
        <SolidColorBrush x:Key="ScrollThumbBrush" Color="#343840" />
        <SolidColorBrush x:Key="ControlHighlightBrush" Color="#08FFFFFF" />
        <SolidColorBrush x:Key="ChipHighlightBrush" Color="#05FFFFFF" />

        <DropShadowEffect x:Key="RowActiveShadowEffect"
                          BlurRadius="8"
                          Direction="270"
                          ShadowDepth="1"
                          Opacity="0.65"
                          Color="#000000" />
        <DropShadowEffect x:Key="ControlShadowEffect"
                          BlurRadius="3"
                          Direction="270"
                          ShadowDepth="1"
                          Opacity="0.3"
                          Color="#000000" />
        <DropShadowEffect x:Key="ChipShadowEffect"
                          BlurRadius="2"
                          Direction="270"
                          ShadowDepth="1"
                          Opacity="0.3"
                          Color="#000000" />
        <DropShadowEffect x:Key="PrimaryShadowEffect"
                          BlurRadius="18"
                          Direction="270"
                          ShadowDepth="3"
                          Opacity="0.24"
                          Color="#C8D2E1" />

        <DrawingBrush x:Key="SelectionTexture"
                      TileMode="Tile"
                      Viewport="0,0,9,9"
                      ViewportUnits="Absolute"
                      Viewbox="0,0,9,9"
                      ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="{DynamicResource PatternBrush}">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="1,1" RadiusX="1" RadiusY="1" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,8" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.32" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ControlButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ControlTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Effect" Value="{DynamicResource ControlShadowEffect}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <local:InsetHighlightBorder x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding Tag}"
                                Effect="{TemplateBinding Effect}"
                                HighlightBrush="{DynamicResource ControlHighlightBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </local:InsetHighlightBorder>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ControlHoverBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.32" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Effect" Value="{DynamicResource PrimaryShadowEffect}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Effect="{TemplateBinding Effect}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PrimaryHoverBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource PrimaryHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.32" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProjectTagItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
            <Setter Property="Background" Value="{DynamicResource TagBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TagBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="TagChrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Opacity" Value="0.62" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="1" />
                                <Setter TargetName="TagChrome" Property="BorderBrush" Value="{DynamicResource ControlHoverBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WorktreeRowItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="13,11" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Background="Transparent" ClipToBounds="True">
                            <Border x:Name="RowBackground"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="9" />
                            <Border x:Name="Texture"
                                    Background="{StaticResource SelectionTexture}"
                                    CornerRadius="9"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Offset="0" Color="#00000000" />
                                        <GradientStop Offset="0.40" Color="#00000000" />
                                        <GradientStop Offset="0.68" Color="#80000000" />
                                        <GradientStop Offset="1" Color="#FF000000" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBackground" Property="Background" Value="{DynamicResource RowHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBackground" Property="Background" Value="{DynamicResource RowActiveBrush}" />
                                <Setter TargetName="RowBackground" Property="BorderBrush" Value="{DynamicResource BadgeBorderBrush}" />
                                <Setter TargetName="RowBackground" Property="Effect" Value="{DynamicResource RowActiveShadowEffect}" />
                                <Setter TargetName="Texture" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Margin="1"
                                                        Background="{DynamicResource ScrollThumbBrush}"
                                                        CornerRadius="3" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="26,0,26,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,26,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="148" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="50"
                        Height="50"
                        CornerRadius="12">
                    <Border.Background>
                        <ImageBrush ImageSource="/RhinoWorktreeLauncher;component/Assets/rhino-launcher.png"
                                    Stretch="Uniform" />
                    </Border.Background>
                </Border>

                <local:TrackingTextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Text="Rhino Launcher"
                           Tracking="-0.015"
                           LineHeight="25.3"
                           Foreground="{DynamicResource TextStrongBrush}"
                           FontSize="23"
                           FontWeight="Medium" />

                <Button x:Name="RefreshButton"
                        Grid.Column="3"
                        Width="148"
                        Height="50"
                        Padding="0"
                        BorderThickness="1"
                        Style="{StaticResource ControlButton}"
                        automation:AutomationProperties.Name="Refresh"
                        Click="Refresh_Click">
                    <Button.Tag>
                        <CornerRadius>8</CornerRadius>
                    </Button.Tag>
                    <Grid Width="146" Height="48">
                        <StackPanel x:Name="RefreshIdle"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <Viewbox Width="14" Height="14" Margin="0,0,8,0">
                                <Path Data="M 13.5,5.5 A 6,6 0 1 0 14,10 M 13.5,2 L 13.5,5.5 L 10,5.5"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent" />
                            </Viewbox>
                            <TextBlock VerticalAlignment="Center"
                                       Text="Refresh"
                                       FontSize="13"
                                       FontWeight="Medium" />
                        </StackPanel>
                        <Grid x:Name="RefreshSync" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" ClipToBounds="True">
                                <Border x:Name="LocalProgressFill"
                                        Width="0"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource ProgressBrush}" />
                                <local:TrackingTextBlock HorizontalAlignment="Stretch"
                                           VerticalAlignment="Center"
                                           Text="LOCAL"
                                           Tracking="0.12"
                                           LineHeight="9.5"
                                           TextAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="9.5"
                                           FontWeight="Medium" />
                            </Grid>
                            <Border Grid.Column="1" Background="{DynamicResource ControlBorderBrush}" />
                            <Grid Grid.Column="2" ClipToBounds="True">
                                <Border x:Name="GitProgressFill"
                                        Width="0"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource ProgressBrush}" />
                                <local:TrackingTextBlock HorizontalAlignment="Stretch"
                                           VerticalAlignment="Center"
                                           Text="GIT"
                                           Tracking="0.12"
                                           LineHeight="9.5"
                                           TextAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="9.5"
                                           FontWeight="Medium" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="9" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ListBox x:Name="ProjectList"
                         Grid.Column="0"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource ProjectTagItem}"
                         SelectionChanged="ProjectList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}"
                                       LineHeight="14.4"
                                       LineStackingStrategy="BlockLineHeight" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="RepositoryPathText"
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"
                           ToolTipService.ShowDuration="30000"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="10.5"
                           LineHeight="12.6"
                           LineStackingStrategy="BlockLineHeight"
                           SizeChanged="RepositoryPathText_SizeChanged" />

                <Button Grid.Column="3"
                        Margin="8,0,0,0"
                        Style="{StaticResource TextButton}"
                        Content="＋ Add project"
                        Click="AddProject_Click" />
            </Grid>

            <Border x:Name="WorktreePanel"
                    Grid.Row="2"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                <Grid ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="20,16,20,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="9" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <local:TrackingTextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="WORKTREES"
                                   Tracking="0.14"
                                   LineHeight="12.6"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="10.5"
                                   FontWeight="Medium" />
                        <TextBlock x:Name="WorktreeCountText"
                                   Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFaintBrush}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="11"
                                   LineHeight="13.2"
                                   LineStackingStrategy="BlockLineHeight" />
                        <TextBlock x:Name="PanelHintText"
                                   Grid.Column="4"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Text="Double-click to launch"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="11.5"
                                   LineHeight="13.8"
                                   LineStackingStrategy="BlockLineHeight" />
                        <Grid Grid.Column="6" Width="200">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="99" />
                                <ColumnDefinition Width="2" />
                                <ColumnDefinition Width="99" />
                            </Grid.ColumnDefinitions>
                            <local:TrackingTextBlock Grid.Column="0"
                                       Margin="0,0,9,0"
                                       HorizontalAlignment="Right"
                                       Text="BEHIND"
                                       Tracking="0.13"
                                       LineHeight="10.8"
                                       TextAlignment="Right"
                                       Foreground="{DynamicResource TextFaintBrush}"
                                       FontSize="9"
                                       FontWeight="Medium" />
                            <local:TrackingTextBlock Grid.Column="2"
                                       Margin="9,0,0,0"
                                       HorizontalAlignment="Left"
                                       Text="AHEAD"
                                       Tracking="0.13"
                                       LineHeight="10.8"
                                       Foreground="{DynamicResource TextFaintBrush}"
                                       FontSize="9"
                                       FontWeight="Medium" />
                        </Grid>
                    </Grid>

                    <Border Grid.Row="0"
                            VerticalAlignment="Bottom"
                            Height="1"
                            Background="{DynamicResource DividerBrush}" />

                    <Grid Grid.Row="1">
                        <ListBox x:Name="WorktreeList"
                                 Margin="8"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemContainerStyle="{StaticResource WorktreeRowItem}"
                                 SelectionChanged="WorktreeList_SelectionChanged"
                                 MouseDoubleClick="WorktreeList_MouseDoubleClick"
                                 KeyDown="WorktreeList_KeyDown"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="8" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <local:InlineIdentityPanel Grid.Row="0"
                                                                   Gap="9">
                                            <TextBlock x:Name="WorktreeName"
                                                       MinWidth="48"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       ToolTip="{Binding DisplayName}"
                                                       Foreground="{DynamicResource TextBodyBrush}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="14"
                                                       LineHeight="16.8"
                                                       LineStackingStrategy="BlockLineHeight"
                                                       FontWeight="Normal" />
                                            <local:InsetHighlightBorder Padding="6,3"
                                                                        VerticalAlignment="Center"
                                                                        Background="{DynamicResource BadgeBrush}"
                                                                        BorderBrush="{DynamicResource BadgeBorderBrush}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="4"
                                                                        Effect="{DynamicResource ChipShadowEffect}"
                                                                        HighlightBrush="{DynamicResource ChipHighlightBrush}"
                                                                        Visibility="{Binding IsPrimary, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <local:TrackingTextBlock Text="DEFAULT"
                                                                         Tracking="0.1"
                                                                         LineHeight="9"
                                                                         Foreground="{DynamicResource TextBadgeBrush}"
                                                                         FontSize="9"
                                                                         FontWeight="Medium" />
                                            </local:InsetHighlightBorder>
                                            <local:InsetHighlightBorder x:Name="PullRequestBadge"
                                                                        Padding="7,3"
                                                                        VerticalAlignment="Center"
                                                                        Background="{DynamicResource FreshBackgroundBrush}"
                                                                        BorderBrush="{DynamicResource FreshBorderBrush}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="4"
                                                                        Effect="{DynamicResource ChipShadowEffect}"
                                                                        HighlightBrush="{DynamicResource ChipHighlightBrush}"
                                                                        Visibility="{Binding HasPullRequest, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse x:Name="PullRequestDot"
                                                             Width="5"
                                                             Height="5"
                                                             Margin="0,0,5,0"
                                                             VerticalAlignment="Center"
                                                             Fill="{DynamicResource AheadFillBrush}" />
                                                    <TextBlock x:Name="PullRequestText"
                                                               Text="{Binding PullRequestLabel}"
                                                               Foreground="{DynamicResource FreshTextBrush}"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               FontSize="10"
                                                               LineHeight="10"
                                                               LineStackingStrategy="BlockLineHeight"
                                                               FontWeight="Medium" />
                                                </StackPanel>
                                            </local:InsetHighlightBorder>
                                        </local:InlineIdentityPanel>

                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="200" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="9" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="9" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <local:InsetHighlightBorder x:Name="FreshnessBadge"
                                                                            Grid.Column="0"
                                                                            Padding="6,3"
                                                                            Background="{DynamicResource FreshBackgroundBrush}"
                                                                            BorderBrush="{DynamicResource FreshBorderBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="4"
                                                                            Effect="{DynamicResource ChipShadowEffect}"
                                                                            HighlightBrush="{DynamicResource ChipHighlightBrush}">
                                                    <local:TrackingTextBlock x:Name="FreshnessText"
                                                               Text="{Binding FreshnessLabel}"
                                                               Tracking="0.1"
                                                               LineHeight="9"
                                                               Foreground="{DynamicResource FreshTextBrush}"
                                                               FontSize="9"
                                                               FontWeight="Medium" />
                                                </local:InsetHighlightBorder>
                                                <local:InsetHighlightBorder Grid.Column="2"
                                                                            Padding="7,3"
                                                                            Background="{DynamicResource DiffBoxBrush}"
                                                                            BorderBrush="{DynamicResource DiffBoxBorderBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="4"
                                                                            Effect="{DynamicResource ChipShadowEffect}"
                                                                            HighlightBrush="{DynamicResource ChipHighlightBrush}">
                                                    <StackPanel VerticalAlignment="Center"
                                                                Orientation="Horizontal">
                                                        <TextBlock x:Name="AddedText"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding LocalAdded, StringFormat=+{0}}"
                                                                   Foreground="{DynamicResource AheadTextBrush}"
                                                                   FontFamily="{StaticResource MonoFont}"
                                                                   FontSize="10.5"
                                                                   LineHeight="10.5"
                                                                   LineStackingStrategy="BlockLineHeight" />
                                                        <Border Width="1"
                                                                Height="9"
                                                                Margin="7,0"
                                                                VerticalAlignment="Center"
                                                                Background="{DynamicResource DiffBoxBorderBrush}" />
                                                        <TextBlock x:Name="DeletedText"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding LocalDeleted, StringFormat=−{0}}"
                                                                   Foreground="{DynamicResource BehindTextBrush}"
                                                                   FontFamily="{StaticResource MonoFont}"
                                                                   FontSize="10.5"
                                                                   LineHeight="10.5"
                                                                   LineStackingStrategy="BlockLineHeight" />
                                                    </StackPanel>
                                                </local:InsetHighlightBorder>
                                                <TextBlock x:Name="ActivityText"
                                                           Grid.Column="4"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding RelativeActivityLabel}"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           FontSize="11"
                                                           LineHeight="11"
                                                           LineStackingStrategy="BlockLineHeight" />
                                            </Grid>

                                            <Grid Grid.Column="2"
                                                  Width="200"
                                                  ToolTip="Compared with the default branch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="99" />
                                                    <ColumnDefinition Width="2" />
                                                    <ColumnDefinition Width="99" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="6" />
                                                    <RowDefinition Height="5" />
                                                </Grid.RowDefinitions>
                                                <TextBlock x:Name="BehindText"
                                                           Grid.Column="0"
                                                           Margin="0,0,9,0"
                                                           HorizontalAlignment="Right"
                                                           Text="{Binding BehindCount}"
                                                           Foreground="{DynamicResource BehindTextBrush}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="10.5"
                                                           LineHeight="10.5"
                                                           LineStackingStrategy="BlockLineHeight" />
                                                <TextBlock x:Name="AheadText"
                                                           Grid.Column="2"
                                                           Margin="9,0,0,0"
                                                           HorizontalAlignment="Left"
                                                           Text="{Binding AheadCount}"
                                                           Foreground="{DynamicResource AheadTextBrush}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="10.5"
                                                           LineHeight="10.5"
                                                           LineStackingStrategy="BlockLineHeight" />
                                                <Border Grid.Column="0"
                                                        Grid.Row="2"
                                                        Background="{DynamicResource TrackBrush}" />
                                                <Border x:Name="BehindBar"
                                                        Grid.Column="0"
                                                        Grid.Row="2"
                                                        Width="{Binding BehindBarWidth}"
                                                        HorizontalAlignment="Right"
                                                        Background="{DynamicResource BehindFillBrush}" />
                                                <Border Grid.Column="1"
                                                        Grid.Row="2"
                                                        Background="{DynamicResource TrackCenterBrush}" />
                                                <Border Grid.Column="2"
                                                        Grid.Row="2"
                                                        Background="{DynamicResource TrackBrush}" />
                                                <Border x:Name="AheadBar"
                                                        Grid.Column="2"
                                                        Grid.Row="2"
                                                        Width="{Binding AheadBarWidth}"
                                                        HorizontalAlignment="Left"
                                                        Background="{DynamicResource AheadFillBrush}" />
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsFresh}" Value="False">
                                            <Setter TargetName="FreshnessBadge" Property="Background" Value="{DynamicResource StaleBackgroundBrush}" />
                                            <Setter TargetName="FreshnessBadge" Property="BorderBrush" Value="{DynamicResource StaleBorderBrush}" />
                                            <Setter TargetName="FreshnessText" Property="Foreground" Value="{DynamicResource StaleTextBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsPullRequestDraft}" Value="True">
                                            <Setter TargetName="PullRequestBadge" Property="Background" Value="{DynamicResource StaleBackgroundBrush}" />
                                            <Setter TargetName="PullRequestBadge" Property="BorderBrush" Value="{DynamicResource StaleBorderBrush}" />
                                            <Setter TargetName="PullRequestText" Property="Foreground" Value="{DynamicResource StaleTextBrush}" />
                                            <Setter TargetName="PullRequestDot" Property="Fill" Value="{DynamicResource TextFaintBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LocalAdded}" Value="0">
                                            <Setter TargetName="AddedText" Property="Foreground" Value="{DynamicResource ZeroTextBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LocalDeleted}" Value="0">
                                            <Setter TargetName="DeletedText" Property="Foreground" Value="{DynamicResource ZeroTextBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasLocalState}" Value="False">
                                            <Setter TargetName="AddedText" Property="Text" Value="+…" />
                                            <Setter TargetName="DeletedText" Property="Text" Value="−…" />
                                            <Setter TargetName="ActivityText" Property="Text" Value="Reading local state…" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding AheadCount}" Value="0">
                                            <Setter TargetName="AheadText" Property="Foreground" Value="{DynamicResource ZeroTextBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding BehindCount}" Value="0">
                                            <Setter TargetName="BehindText" Property="Foreground" Value="{DynamicResource ZeroTextBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasGitState}" Value="False">
                                            <Setter TargetName="AheadText" Property="Text" Value="…" />
                                            <Setter TargetName="BehindText" Property="Text" Value="…" />
                                            <Setter TargetName="AheadText" Property="Foreground" Value="{DynamicResource ZeroTextBrush}" />
                                            <Setter TargetName="BehindText" Property="Foreground" Value="{DynamicResource ZeroTextBrush}" />
                                            <Setter TargetName="AheadBar" Property="Width" Value="0" />
                                            <Setter TargetName="BehindBar" Property="Width" Value="0" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                            <Setter TargetName="WorktreeName" Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
                                            <Setter TargetName="WorktreeName" Property="FontWeight" Value="Medium" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="EmptyStateText"
                                   Margin="40"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="No worktrees found"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="12"
                                   Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Padding="26,14,26,18"
                Background="{DynamicResource FooterBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="164" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="164" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <local:TrackingTextBlock Text="SELECTED"
                               Tracking="0.12"
                               LineHeight="10"
                               Foreground="{DynamicResource TextFaintBrush}"
                               FontSize="10" />
                    <TextBlock x:Name="SelectedWorktreeText"
                               Margin="0,5,0,0"
                               Text="No worktree selected"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               Foreground="{DynamicResource TextStrongBrush}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="12.5"
                               LineHeight="15"
                               LineStackingStrategy="BlockLineHeight"
                               FontWeight="Medium" />
                </StackPanel>

                <Button x:Name="OpenFolderButton"
                        Grid.Column="2"
                        Width="164"
                        Height="48"
                        Style="{StaticResource ControlButton}"
                        Content="Open folder"
                        FontSize="13"
                        Click="OpenFolder_Click">
                    <Button.Tag>
                        <CornerRadius>9</CornerRadius>
                    </Button.Tag>
                </Button>

                <Button x:Name="LaunchButton"
                        Grid.Column="4"
                        Width="164"
                        Height="48"
                        Style="{StaticResource PrimaryButton}"
                        Content="Launch Rhino"
                        Click="Launch_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
