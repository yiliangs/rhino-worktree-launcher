<Window x:Class="RhinoWorktreeLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Rhino Worktree Launcher"
        Width="720"
        Height="1000"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#16181B"
        Loaded="Window_Loaded">
    <Grid>
        <Grid x:Name="LoadingSurface" Panel.ZIndex="1" Background="#16181B">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border x:Name="LoadingLogoPlate"
                        Width="64"
                        Height="64"
                        Margin="0,0,0,18"
                        HorizontalAlignment="Center"
                        Background="#F4F6F8"
                        CornerRadius="15">
                    <Image Source="/RhinoWorktreeLauncher;component/Assets/rhino-launcher.png"
                           Stretch="Uniform" />
                </Border>
                <TextBlock x:Name="LoadingTitle"
                           HorizontalAlignment="Center"
                           Foreground="#F0F2F5"
                           FontFamily="Segoe UI"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Text="Rhino Launcher" />
                <TextBlock x:Name="LoadingStatus"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Center"
                           Foreground="#6C727A"
                           FontFamily="Segoe UI"
                           FontSize="12"
                           Text="Starting interface..." />
            </StackPanel>
        </Grid>
        <wv2:WebView2 x:Name="Browser"
                      Panel.ZIndex="2"
                      Visibility="Hidden" />
    </Grid>
</Window>
