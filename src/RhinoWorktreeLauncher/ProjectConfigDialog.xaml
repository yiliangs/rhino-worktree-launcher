<Window x:Class="RhinoWorktreeLauncher.ProjectConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RhinoWorktreeLauncher"
        Title="Project config"
        Width="720"
        Height="820"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBodyBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">
    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="ConfigContentScrollViewer"
                      Grid.Row="0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="26,0">
                <Grid Margin="0,26,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="50"
                            Height="50"
                            Background="{DynamicResource PrimaryBrush}"
                            CornerRadius="12"
                            Effect="{DynamicResource LogoShadowEffect}">
                        <TextBlock x:Name="ProjectInitialText"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                    </Border>
                    <StackPanel Grid.Column="2" Margin="0,3,0,0">
                        <TextBlock x:Name="ProjectNameText"
                                   Foreground="{DynamicResource TextStrongBrush}"
                                   FontSize="23"
                                   FontWeight="Medium"
                                   LineHeight="25" />
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ProjectPathRail"
                                    Grid.Column="0"
                                    Width="1"
                                    Height="12"
                                    Margin="0,0,9,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource DividerBrush}" />
                            <TextBlock x:Name="ProjectPathText"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="11"
                                       Opacity="0.85"
                                       TextTrimming="None"
                                       SizeChanged="ProjectPathText_SizeChanged" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <Border Margin="0,0,0,18"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <StackPanel>
                        <Border Padding="20,14,20,12" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                            <local:TrackingTextBlock Text="REPOSITORY ACCESS"
                                                     Tracking="0.14"
                                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                                     FontSize="10.5"
                                                     FontWeight="Medium" />
                        </Border>
                        <CheckBox IsChecked="True"
                                  IsEnabled="False"
                                  AutomationProperties.Name="Project files, required"
                                  Style="{StaticResource SettingsToggleRow}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center"
                                               Text="Project files"
                                               Foreground="{DynamicResource TextStrongBrush}"
                                               FontSize="13.5" />
                                    <Border Margin="9,0,0,0"
                                            Padding="6,3"
                                            Background="{DynamicResource BadgeBrush}"
                                            BorderBrush="{DynamicResource BadgeBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                        <local:TrackingTextBlock Text="REQUIRED"
                                                                 Tracking="0.1"
                                                                 Foreground="{DynamicResource TextBadgeBrush}"
                                                                 FontSize="9"
                                                                 FontWeight="Medium" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Margin="0,5,0,0"
                                           Text="Reads the Git project; the selected solution writes ordinary build outputs."
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="12"
                                           LineHeight="18"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <Border Height="1" Margin="20,0" Background="{DynamicResource DividerBrush}" />
                        <CheckBox x:Name="RemoteReadToggle"
                                  IsChecked="True"
                                  AutomationProperties.Name="Remote status"
                                  Style="{StaticResource SettingsToggleRow}">
                            <StackPanel>
                                <TextBlock Text="Remote status"
                                           Foreground="{DynamicResource TextStrongBrush}"
                                           FontSize="13.5" />
                                <TextBlock Margin="0,5,0,0"
                                           Text="Fetches remote branches and pull requests into RWL storage."
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="12"
                                           LineHeight="18"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <Border Margin="0,0,0,22"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <StackPanel>
                        <Border Padding="20,14,20,12" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <local:TrackingTextBlock Text="BUILD CONFIGURATION"
                                                         Tracking="0.14"
                                                         Foreground="{DynamicResource TextSecondaryBrush}"
                                                         FontSize="10.5"
                                                         FontWeight="Medium" />
                                <TextBlock HorizontalAlignment="Right"
                                           Text="Visual Studio solution"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="11.5" />
                            </Grid>
                        </Border>
                        <StackPanel Margin="20,15,20,18">
                            <TextBlock Text="Rhino plug-in project" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" />
                            <ComboBox x:Name="PluginProjectComboBox"
                                      Margin="0,7,0,16"
                                      ItemTemplate="{StaticResource PluginProjectDropdownValue}"
                                      IsEnabled="False"
                                      SelectionChanged="PluginProject_SelectionChanged"
                                      Tag="Loading build choices..."
                                      Style="{StaticResource BuildCombo}" />
                            <TextBlock Text="Solution" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" />
                            <ComboBox x:Name="SolutionComboBox"
                                      Margin="0,7,0,16"
                                      ItemTemplate="{StaticResource SolutionDropdownValue}"
                                      IsEnabled="False"
                                      SelectionChanged="Solution_SelectionChanged"
                                      Tag="Select a plug-in project first"
                                      Style="{StaticResource BuildCombo}" />
                            <TextBlock Text="Configuration" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" />
                            <ComboBox x:Name="BuildConfigurationComboBox"
                                      Margin="0,7,0,15"
                                      ItemTemplate="{StaticResource BuildConfigurationDropdownValue}"
                                      IsEnabled="False"
                                      Tag="Select a solution first"
                                      Style="{StaticResource BuildCombo}" />
                            <CheckBox x:Name="BuildBeforeLaunchToggle"
                                      IsChecked="True"
                                      Padding="0,15"
                                      AutomationProperties.Name="Build before launch"
                                      Style="{StaticResource SettingsToggleRow}">
                                <StackPanel>
                                    <TextBlock Text="Build &amp; Launch"
                                               Foreground="{DynamicResource TextStrongBrush}"
                                               FontSize="13.5" />
                                    <TextBlock Margin="0,5,0,0"
                                               Text="Turn off for Direct Launch, which loads the existing .rhp without rebuilding."
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="12"
                                               LineHeight="18"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <TextBlock x:Name="ValidationText"
                                       Margin="0,7,0,0"
                                       Foreground="{DynamicResource ValidationBrush}"
                                       FontSize="11"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border x:Name="ConfigFooter"
                Grid.Row="1"
                Padding="26,14,26,18"
                Background="{DynamicResource FooterBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="ClearRemoteCacheToggle"
                          VerticalAlignment="Center"
                          Content="Clear remote cache"
                          Style="{StaticResource StandardCheckBox}" />
                <Button Grid.Column="1"
                        Content="Cancel"
                        IsCancel="True"
                        Style="{StaticResource SecondaryButton}"
                        Click="Cancel_Click" />
                <Button x:Name="SaveConfigButton"
                        Grid.Column="3"
                        Content="Save config"
                        IsEnabled="False"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButton}"
                        Click="Save_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
