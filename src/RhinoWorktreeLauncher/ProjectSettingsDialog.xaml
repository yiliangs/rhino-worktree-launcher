<Window x:Class="RhinoWorktreeLauncher.ProjectSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RhinoWorktreeLauncher"
        Title="Project settings"
        Width="720"
        Height="680"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBodyBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#16181B" />
        <SolidColorBrush x:Key="PanelBrush" Color="#1A1C20" />
        <SolidColorBrush x:Key="FooterBrush" Color="#121417" />
        <SolidColorBrush x:Key="ControlBrush" Color="#1B1D21" />
        <SolidColorBrush x:Key="ControlHoverBrush" Color="#22252A" />
        <SolidColorBrush x:Key="RowHoverBrush" Color="#1F2226" />
        <SolidColorBrush x:Key="RowActiveBrush" Color="#262B31" />
        <SolidColorBrush x:Key="TrackBrush" Color="#1C1F23" />
        <SolidColorBrush x:Key="TrackCenterBrush" Color="#3A4048" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#26292E" />
        <SolidColorBrush x:Key="DividerBrush" Color="#232629" />
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#2E3238" />
        <SolidColorBrush x:Key="ControlHoverBorderBrush" Color="#464C54" />
        <SolidColorBrush x:Key="BadgeBrush" Color="#1F2329" />
        <SolidColorBrush x:Key="BadgeBorderBrush" Color="#333941" />
        <SolidColorBrush x:Key="TextStrongBrush" Color="#F0F2F5" />
        <SolidColorBrush x:Key="TextBodyBrush" Color="#E6E8EB" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#878D95" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#6C727A" />
        <SolidColorBrush x:Key="TextBadgeBrush" Color="#A5AEBA" />
        <SolidColorBrush x:Key="ControlTextBrush" Color="#B2B8C0" />
        <SolidColorBrush x:Key="AccentBrush" Color="#8FAE8B" />
        <SolidColorBrush x:Key="ToggleOnBrush" Color="#5F8A5C" />
        <SolidColorBrush x:Key="ToggleOnBorderBrush" Color="#537A51" />
        <SolidColorBrush x:Key="ToggleOffBrush" Color="#24272C" />
        <SolidColorBrush x:Key="ToggleOffBorderBrush" Color="#31353B" />
        <SolidColorBrush x:Key="ToggleKnobBrush" Color="#F0F2F5" />
        <SolidColorBrush x:Key="ToggleKnobOffBrush" Color="#7D848D" />
        <SolidColorBrush x:Key="PatternBrush" Color="#1AB2C0D3" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#F0F2F5" />
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#16181B" />
        <SolidColorBrush x:Key="ValidationBrush" Color="#C07D76" />

        <DropShadowEffect x:Key="ControlShadowEffect"
                          BlurRadius="3"
                          Direction="270"
                          ShadowDepth="1"
                          Opacity="0.3"
                          Color="#000000" />
        <DropShadowEffect x:Key="RowActiveShadowEffect"
                          BlurRadius="8"
                          Direction="270"
                          ShadowDepth="1"
                          Opacity="0.65"
                          Color="#000000" />
        <DropShadowEffect x:Key="PrimaryShadowEffect"
                          BlurRadius="10"
                          Direction="270"
                          ShadowDepth="2"
                          Opacity="0.18"
                          Color="#C8D2E1" />
        <DropShadowEffect x:Key="LogoShadowEffect"
                          BlurRadius="12"
                          Direction="270"
                          ShadowDepth="4"
                          Opacity="0.5"
                          Color="#000000" />

        <DrawingBrush x:Key="SelectionTexture"
                      TileMode="Tile"
                      Viewport="0,0,9,9"
                      ViewportUnits="Absolute"
                      Viewbox="0,0,9,9"
                      ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="{DynamicResource PatternBrush}">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="1,1" RadiusX="1" RadiusY="1" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="SettingsToggleRow" TargetType="CheckBox">
            <Setter Property="Padding" Value="20,15" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center" />
                                <Grid x:Name="ToggleVisual"
                                      Grid.Column="2"
                                      Width="34"
                                      Height="20"
                                      VerticalAlignment="Center">
                                    <Border x:Name="Track"
                                            Background="{DynamicResource ToggleOffBrush}"
                                            BorderBrush="{DynamicResource ToggleOffBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10" />
                                    <Ellipse x:Name="Knob"
                                             Width="14"
                                             Height="14"
                                             Margin="3"
                                             HorizontalAlignment="Left"
                                             Fill="{DynamicResource ToggleKnobOffBrush}" />
                                    <Border x:Name="FocusRing"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="1"
                                            CornerRadius="10" />
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource ToggleOnBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ToggleOnBorderBrush}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource ToggleKnobBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ControlHoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ToggleVisual" Property="Opacity" Value="0.5" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BuildChoice" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Row"
                                Padding="13,12"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="9">
                            <Grid ClipToBounds="True">
                                <Rectangle x:Name="Texture"
                                           Margin="-13,-12"
                                           Fill="{StaticResource SelectionTexture}"
                                           Visibility="Collapsed">
                                    <Rectangle.OpacityMask>
                                        <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                                            <GradientStop Offset="0" Color="#FFFFFFFF" />
                                            <GradientStop Offset="0.32" Color="#80FFFFFF" />
                                            <GradientStop Offset="0.60" Color="#00FFFFFF" />
                                        </LinearGradientBrush>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="15" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid VerticalAlignment="Center" Width="15" Height="15">
                                        <Ellipse x:Name="Ring"
                                                 Stroke="{DynamicResource TrackCenterBrush}"
                                                 StrokeThickness="1" />
                                        <Ellipse x:Name="Dot"
                                                 Width="7"
                                                 Height="7"
                                                 Fill="{DynamicResource AccentBrush}"
                                                 Visibility="Collapsed" />
                                    </Grid>
                                    <ContentPresenter Grid.Column="2" VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource RowHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
                                <Setter Property="FontWeight" Value="Medium" />
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource RowActiveBrush}" />
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
                                <Setter TargetName="Row" Property="Effect" Value="{DynamicResource RowActiveShadowEffect}" />
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Texture" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource ControlHoverBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Padding" Value="20,12" />
            <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ControlTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Effect" Value="{DynamicResource ControlShadowEffect}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ControlHoverBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ControlHoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="26,12" />
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Effect" Value="{DynamicResource PrimaryShadowEffect}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PrimaryHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ControlHoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="26,0">
                <Grid Margin="0,26,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="50"
                            Height="50"
                            Background="{DynamicResource PrimaryBrush}"
                            CornerRadius="12"
                            Effect="{DynamicResource LogoShadowEffect}">
                        <TextBlock x:Name="ProjectInitialText"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                    </Border>
                    <StackPanel Grid.Column="2" Margin="0,3,0,0">
                        <TextBlock x:Name="ProjectNameText"
                                   Foreground="{DynamicResource TextStrongBrush}"
                                   FontSize="23"
                                   FontWeight="Medium"
                                   LineHeight="25" />
                        <TextBlock x:Name="ProjectPathText"
                                   Margin="0,7,0,0"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="11"
                                   Opacity="0.85"
                                   TextTrimming="None"
                                   SizeChanged="ProjectPathText_SizeChanged" />
                    </StackPanel>
                </Grid>

                <Border Margin="0,0,0,18"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <StackPanel>
                        <Border Padding="20,14,20,12" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                            <local:TrackingTextBlock Text="REPOSITORY ACCESS"
                                                     Tracking="0.14"
                                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                                     FontSize="10.5"
                                                     FontWeight="Medium" />
                        </Border>
                        <CheckBox IsChecked="True"
                                  IsEnabled="False"
                                  AutomationProperties.Name="Project files, required"
                                  Style="{StaticResource SettingsToggleRow}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center"
                                               Text="Project files"
                                               Foreground="{DynamicResource TextStrongBrush}"
                                               FontSize="13.5" />
                                    <Border Margin="9,0,0,0"
                                            Padding="6,3"
                                            Background="{DynamicResource BadgeBrush}"
                                            BorderBrush="{DynamicResource BadgeBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                        <local:TrackingTextBlock Text="REQUIRED"
                                                                 Tracking="0.1"
                                                                 Foreground="{DynamicResource TextBadgeBrush}"
                                                                 FontSize="9"
                                                                 FontWeight="Medium" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Margin="0,5,0,0"
                                           Text="Reads the Git project and its worktrees. Never written to."
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="12"
                                           LineHeight="18"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <Border Height="1" Margin="20,0" Background="{DynamicResource DividerBrush}" />
                        <CheckBox x:Name="RemoteReadToggle"
                                  IsChecked="True"
                                  AutomationProperties.Name="Remote status"
                                  Style="{StaticResource SettingsToggleRow}">
                            <StackPanel>
                                <TextBlock Text="Remote status"
                                           Foreground="{DynamicResource TextStrongBrush}"
                                           FontSize="13.5" />
                                <TextBlock Margin="0,5,0,0"
                                           Text="Fetches remote branches and pull requests into RWL storage."
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="12"
                                           LineHeight="18"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <Border Margin="0,0,0,22"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <StackPanel>
                        <Border Padding="20,14,20,12" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <local:TrackingTextBlock Text="BUILD SETUP"
                                                         Tracking="0.14"
                                                         Foreground="{DynamicResource TextSecondaryBrush}"
                                                         FontSize="10.5"
                                                         FontWeight="Medium" />
                                <TextBlock HorizontalAlignment="Right"
                                           Text="Plug-in project detected"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="11.5" />
                            </Grid>
                        </Border>
                        <StackPanel Margin="8">
                            <RadioButton x:Name="DetectedBuildChoice"
                                         GroupName="BuildMode"
                                         IsChecked="True"
                                         Style="{StaticResource BuildChoice}"
                                         Checked="BuildChoice_Changed">
                                <StackPanel>
                                    <TextBlock Text="Use the detected setup"
                                               FontSize="13.5" />
                                    <TextBlock Margin="0,5,0,0"
                                               Text="RWL builds the plug-in project into an editable, app-owned profile."
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="12"
                                               LineHeight="18"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="CustomDriverChoice"
                                         GroupName="BuildMode"
                                         Style="{StaticResource BuildChoice}"
                                         Checked="BuildChoice_Changed">
                                <StackPanel>
                                    <TextBlock Text="Import my own driver"
                                               FontSize="13.5" />
                                    <TextBlock Margin="0,5,0,0"
                                               Text="Advanced. RWL copies your PowerShell driver into its own storage."
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="12"
                                               LineHeight="18"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                            <Grid x:Name="DriverPicker" Margin="40,6,13,5" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Padding="11,9"
                                        Background="{DynamicResource ControlBrush}"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                    <TextBlock x:Name="DriverPathText"
                                               Text="No driver selected"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="10.5" />
                                </Border>
                                <Button Grid.Column="2"
                                        Padding="13,9"
                                        Content="Choose file"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="ChooseDriver_Click" />
                            </Grid>
                            <TextBlock x:Name="ValidationText"
                                       Margin="40,4,13,5"
                                       Foreground="{DynamicResource ValidationBrush}"
                                       FontSize="11"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>
                </Border>
        </StackPanel>

        <Border Grid.Row="1"
                Padding="26,14,26,18"
                Background="{DynamicResource FooterBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="ClearCacheToggle"
                          VerticalAlignment="Center"
                          Content="Clear build and remote caches"
                          Style="{StaticResource StandardCheckBox}" />
                <Button Grid.Column="1"
                        Content="Cancel"
                        IsCancel="True"
                        Style="{StaticResource SecondaryButton}"
                        Click="Cancel_Click" />
                <Button Grid.Column="3"
                        Content="Save settings"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButton}"
                        Click="Save_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
