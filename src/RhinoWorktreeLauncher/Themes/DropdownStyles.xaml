<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="DropdownMenuBrush" Color="#202329" />
    <SolidColorBrush x:Key="DropdownMenuBorderBrush" Color="#33383F" />
    <SolidColorBrush x:Key="DropdownOpenBorderBrush" Color="#5A616B" />
    <SolidColorBrush x:Key="DropdownDisabledBrush" Color="#191B1E" />
    <SolidColorBrush x:Key="DropdownDisabledBorderBrush" Color="#25282C" />
    <SolidColorBrush x:Key="DropdownFocusRingBrush" Color="#2E8FAE8B" />
    <SolidColorBrush x:Key="DropdownSelectedBorderBrush" Color="#2B3037" />
    <SolidColorBrush x:Key="DropdownAccentBrush" Color="#8FAE8B" />

    <DropShadowEffect x:Key="DropdownControlShadowEffect"
                      BlurRadius="2"
                      Direction="270"
                      ShadowDepth="1"
                      Opacity="0.3"
                      Color="#000000" />
    <DropShadowEffect x:Key="DropdownMenuShadowEffect"
                      BlurRadius="20"
                      Direction="270"
                      ShadowDepth="8"
                      Opacity="0.6"
                      Color="#000000" />

    <DrawingBrush x:Key="DropdownSelectionTexture"
                  TileMode="Tile"
                  Viewport="0,0,9,9"
                  ViewportUnits="Absolute"
                  Viewbox="0,0,9,9"
                  ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="{DynamicResource PatternBrush}">
                <GeometryDrawing.Geometry>
                    <EllipseGeometry Center="1,1" RadiusX="1" RadiusY="1" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <DataTemplate x:Key="ProjectDropdownValue">
        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
    </DataTemplate>
    <DataTemplate x:Key="PluginProjectDropdownValue">
        <TextBlock Text="{Binding PluginProjectPath}" TextTrimming="CharacterEllipsis" />
    </DataTemplate>
    <DataTemplate x:Key="SolutionDropdownValue">
        <TextBlock Text="{Binding SolutionPath}" TextTrimming="CharacterEllipsis" />
    </DataTemplate>
    <DataTemplate x:Key="BuildConfigurationDropdownValue">
        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
    </DataTemplate>

    <Style x:Key="DropdownItem" TargetType="ComboBoxItem">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <ControlTemplate.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        </Style>
                    </ControlTemplate.Resources>
                    <Border x:Name="ItemChrome"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="7"
                            SnapsToDevicePixels="True">
                        <Grid ClipToBounds="True">
                            <Rectangle x:Name="SelectedTexture"
                                       Margin="-10,0"
                                       Fill="{DynamicResource DropdownSelectionTexture}"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed">
                                <Rectangle.OpacityMask>
                                    <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                                        <GradientStop Offset="0" Color="#FFFFFFFF" />
                                        <GradientStop Offset="0.32" Color="#80FFFFFF" />
                                        <GradientStop Offset="0.60" Color="#00FFFFFF" />
                                    </LinearGradientBrush>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="ItemContent"
                                                  Margin="0,0,8,0"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}"
                                                  ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
                                <Path x:Name="SelectedCheck"
                                      Grid.Column="1"
                                      Width="9"
                                      Height="8"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Data="M 0.5,4 L 3.2,6.7 L 8.5,0.7"
                                      Stretch="Fill"
                                      Stroke="{DynamicResource DropdownAccentBrush}"
                                      StrokeEndLineCap="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeThickness="1.4"
                                      Visibility="Collapsed" />
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource RowHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource RowActiveBrush}" />
                            <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{DynamicResource DropdownSelectedBorderBrush}" />
                            <Setter TargetName="SelectedTexture" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SelectedCheck" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
                            <Setter Property="FontWeight" Value="Medium" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ProjectDropdownItem" TargetType="ComboBoxItem" BasedOn="{StaticResource DropdownItem}">
        <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
    </Style>

    <Style x:Key="BuildCombo" TargetType="ComboBox">
        <Setter Property="Height" Value="38" />
        <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource DropdownItem}" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <ControlTemplate.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        </Style>
                    </ControlTemplate.Resources>
                    <Grid x:Name="DropdownRoot">
                        <Border x:Name="FocusRing"
                                Margin="-3"
                                Background="Transparent"
                                BorderBrush="{DynamicResource DropdownFocusRingBrush}"
                                BorderThickness="3"
                                CornerRadius="12"
                                IsHitTestVisible="False"
                                Opacity="0" />
                        <Border x:Name="DropdownChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Effect="{DynamicResource DropdownControlShadowEffect}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <ContentPresenter x:Name="SelectedValue"
                                                  Margin="13,0,37,0"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  IsHitTestVisible="False" />
                                <TextBlock x:Name="Placeholder"
                                           Margin="13,0,37,0"
                                           VerticalAlignment="Center"
                                           FontFamily="{DynamicResource UiFont}"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           IsHitTestVisible="False"
                                           Text="{TemplateBinding Tag}"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="Collapsed" />
                                <Path x:Name="DropdownCaret"
                                      Width="9"
                                      Height="5"
                                      Margin="0,0,15,0"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Data="M 0.7,0.7 L 4.5,4.3 L 8.3,0.7"
                                      RenderTransformOrigin="0.5,0.5"
                                      Stretch="Fill"
                                      Stroke="{DynamicResource TextFaintBrush}"
                                      StrokeEndLineCap="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeThickness="1.2">
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="CaretRotation" Angle="0" />
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                        </Border>
                        <ToggleButton x:Name="DropdownToggle"
                                      Background="Transparent"
                                      ClickMode="Press"
                                      Cursor="{TemplateBinding Cursor}"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               PopupAnimation="None"
                               StaysOpen="False"
                               VerticalOffset="6">
                            <Grid Width="{Binding ActualWidth, ElementName=DropdownChrome}"
                                  Margin="18">
                                <Border x:Name="MenuChrome"
                                        Padding="6"
                                        Background="{DynamicResource DropdownMenuBrush}"
                                        BorderBrush="{DynamicResource DropdownMenuBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="11"
                                        Effect="{DynamicResource DropdownMenuShadowEffect}">
                                    <ScrollViewer x:Name="DropDownScrollViewer"
                                                  MaxHeight="256"
                                                  CanContentScroll="True"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SelectedIndex" Value="-1">
                            <Setter TargetName="SelectedValue" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="DropdownChrome" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            <Setter TargetName="DropdownChrome" Property="BorderBrush" Value="{DynamicResource ControlHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            <Setter TargetName="DropdownChrome" Property="BorderBrush" Value="{DynamicResource DropdownOpenBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            <Setter TargetName="DropdownChrome" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            <Setter TargetName="DropdownChrome" Property="BorderBrush" Value="{DynamicResource DropdownOpenBorderBrush}" />
                            <Setter TargetName="DropdownCaret" Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CaretRotation"
                                                         Storyboard.TargetProperty="Angle"
                                                         To="180"
                                                         Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CaretRotation"
                                                         Storyboard.TargetProperty="Angle"
                                                         To="0"
                                                         Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="DropdownRoot" Property="Opacity" Value="0.5" />
                            <Setter TargetName="DropdownChrome" Property="Background" Value="{DynamicResource DropdownDisabledBrush}" />
                            <Setter TargetName="DropdownChrome" Property="BorderBrush" Value="{DynamicResource DropdownDisabledBorderBrush}" />
                            <Setter TargetName="DropdownChrome" Property="Effect" Value="{x:Null}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
